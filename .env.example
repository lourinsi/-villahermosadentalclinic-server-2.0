# Copy this file to .env for local development.
# Local development and production must use different databases.
# Never point localhost/dev at the production DATABASE_URL.

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated extra origins, if needed.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

# Local development database
# Create a separate local/dev database named villahermosa_dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/villahermosa_dev"

# Prisma migrations/introspection direct connection.
# For a local database, this can usually match DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/villahermosa_dev"

# Optional: set to false only when your hosted database requires it.
# Leave unset for local Postgres.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Production database notes:
# - Do not put production credentials in .env.example.
# - Set production DATABASE_URL, DIRECT_URL, FRONTEND_URL, and JWT_SECRET
#   in your hosting provider dashboard only.
# - If you use Supabase pooler in production, DATABASE_URL is usually the pooled
#   runtime URL and DIRECT_URL is the direct/session URL for migrations.
#
# Production example shape only:
# DATABASE_URL="postgresql://prod_user:prod_password@prod-host:6543/prod_db?pgbouncer=true"
# DIRECT_URL="postgresql://prod_user:prod_password@prod-host:5432/prod_db"
# FRONTEND_URL=https://your-production-frontend.example.com
# NODE_ENV=production

# Authentication
# Use a long random secret locally. Use a different secret in production.
JWT_SECRET="replace-with-a-long-random-local-secret"

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
